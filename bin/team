#!/usr/bin/env bash
# ==============================================================================
# HiveForge v3.5: Multi-CLI Autonomous Agent Team Orchestrator
# Compatible with: agy, claude, codex, aider, ollama, custom scripts
# ==============================================================================
set -e

# Detect repository directory portably (resolving symlinks)
TARGET_FILE="${BASH_SOURCE[0]}"
while [ -L "$TARGET_FILE" ]; do
  TARGET_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
  TARGET_FILE="$(readlink "$TARGET_FILE")"
  [[ $TARGET_FILE != /* ]] && TARGET_FILE="$TARGET_DIR/$TARGET_FILE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$TARGET_FILE")" && pwd)"
ENGINE_DIR="$(cd -P "$SCRIPT_DIR/.." && pwd)"

export ENGINE_DIR
BASE_DIR="${AGY_TEAMS_DIR:-$HOME/.agy-teams}"
TEAMS_DIR="$BASE_DIR/teams"
API_URL="${AGY_API_URL:-http://127.0.0.1:4444}"
# Most recently created team (replaces the old hardcoded "anikuro" default)
default_team() {
  python3 -c "import sqlite3,sys;r=sqlite3.connect(sys.argv[1]).execute('SELECT name FROM teams ORDER BY created_at DESC LIMIT 1').fetchone();print(r[0] if r else '')" "$BASE_DIR/state.db" 2>/dev/null
}
mkdir -p "$TEAMS_DIR"

ensure_server_running() {
  local port="${API_URL##*:}"
  port="${port%%/*}"
  if ! ss -tulpn 2>/dev/null | grep -q ":$port "; then
    systemctl --user start agy-vibe.service 2>/dev/null || nohup python3 "$ENGINE_DIR/server.py" "$port" >/tmp/agy-ui.log 2>&1 &
    sleep 0.8
  fi
}

cmd_tmux() {
  local team="${1:-$(default_team)}"
  which tmux >/dev/null 2>&1 || { echo "[HATA] tmux kurulu değil! Lütfen 'sudo apt install tmux' çalıştırın."; exit 1; }
  local sname="mission-${team}"
  ensure_server_running

  if tmux has-session -t "$sname" 2>/dev/null; then
    echo "Mevcut Mission Control oturumuna bağlanılıyor: $sname"
    tmux attach-session -t "$sname"
    return
  fi

  echo "Yeni canlı Terminal Mission Control oluşturuluyor: $sname"
  local my_bin="${BASH_SOURCE[0]}"
  
  tmux new-session -d -s "$sname" -n "cockpit" "$my_bin watch $team all"
  tmux set -t "$sname" mouse on
  tmux set -t "$sname" status-style "bg=#0d0f12,fg=#10b981"
  tmux set -t "$sname" pane-border-style "fg=#27272a"
  tmux set -t "$sname" pane-active-border-style "fg=#f59e0b"

  python3 - "$team" "$sname" "$my_bin" << 'PYEOF'
import os, sys, subprocess
sys.path.insert(0, os.environ.get("ENGINE_DIR", "."))
import engine

team_name, sname, my_bin = sys.argv[1], sys.argv[2], sys.argv[3]
with engine.get_db() as conn:
    agents = conn.execute("SELECT target, name FROM agents WHERE team_name=? ORDER BY aid ASC", (team_name,)).fetchall()

subprocess.run(["tmux", "new-window", "-t", sname, "-n", "lead", f"{my_bin} watch {team_name} @lead"])
for ag in agents[:6]:
    wname = ag["target"].lstrip("@")[:8]
    subprocess.run(["tmux", "new-window", "-t", sname, "-n", wname, f"{my_bin} watch {team_name} {ag['target']}"])
PYEOF

  tmux select-window -t "$sname:cockpit"
  tmux attach-session -t "$sname"
}

# Everything else lives in the cross-platform hive.py (single implementation; this wrapper only adds tmux & setup).
case "${1:-}" in
  tmux|attach|attach-session|mission-control)
    shift || true
    cmd_tmux "$@"
    ;;
  setup|install)
    bash "$ENGINE_DIR/install.sh"
    ;;
  recover)
    shift || true
    exec python3 "$ENGINE_DIR/bin/hive.py" restore "$@"
    ;;
  *)
    exec python3 "$ENGINE_DIR/bin/hive.py" "$@"
    ;;
esac
